{
  "name": "xiubo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "锈泊 — 对标 Saltline 品质的国产港区短任务 FPS。模块化源码，可打成单文件 HTML。",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8743",
    "start": "vite --host 127.0.0.1 --port 8743",
    "build": "vite build",
    "build:single": "vite build --config vite.single.config.js",
    "preview": "vite preview --host 127.0.0.1 --port 8743",
    "check": "node scripts/check-source.mjs && node scripts/verify-archive.mjs",
    "format": "prettier --write index.html \"src/**/*.js\" src/*.css vite.config.js scripts/*.mjs scripts/lib/*.mjs",
    "verify:archive": "node scripts/verify-archive.mjs",
    "verify:refactor": "node scripts/verify-refactor.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@babel/parser": "7.29.13",
    "@babel/traverse": "7.29.13",
    "prettier": "3.9.10",
    "vite": "6.4.1",
    "vite-plugin-singlefile": "2.3.0"
  }
}
